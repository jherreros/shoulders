{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "separateMajorMinor": true,
  "npm": {
    "rangeStrategy": "bump"
  },
  "flux": {
    "managerFilePatterns": [
      "/(^|/)2-addons/manifests/.*\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)1-cluster/kind-config\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)1-cluster/vind-config(-small|-large)?\\.yaml$/",
        "/(^|/)shoulders-cli/internal/manifests/vind-config\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+version:\\s*(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Hold TypeScript at v6 until typescript-eslint + headlamp-plugin support TS7 (blocked on typescript-eslint#10940, TS7 has no API yet)",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Hold k8s 0.36 until vcluster supports k8s 1.37 (vcluster 0.37.x requires k8s 0.36, 0.37 breaks loft-sh/apiserver typecheck)",
      "matchManagers": ["gomod"],
      "matchPackagePatterns": ["^k8s\\.io/"],
      "allowedVersions": "<0.37"
    },
    {
      "description": "Hold helm 4.2 until k8s 1.37 support lands (helm 4.3 requires k8s 0.37)",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["helm.sh/helm/v4"],
      "allowedVersions": "<4.3.0"
    },
    {
      "description": "Hold etcd 3.6 until vcluster supports etcd 3.7 (vcluster 0.37.x pins etcd 3.6, 3.7 breaks snapshot API)",
      "matchManagers": ["gomod"],
      "matchPackagePatterns": ["^go\\.etcd\\.io/"],
      "allowedVersions": "<3.7.0"
    },
    {
      "description": "Hold vind k8s distro at v1.36.x until loft-sh publishes a 1.37 image (v1.37.1-full manifest unknown, breaks shoulders up)",
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["kubernetes/kubernetes"],
      "allowedVersions": "<1.37.0"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "matchManagers": [
        "flux"
      ],
      "matchDatasources": [
        "helm"
      ],
      "groupName": "platform charts"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "node dependencies"
    }
  ]
}
