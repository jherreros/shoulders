{
  "name": "shoulders-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for the Shoulders internal developer platform.",
  "main": "dist/server.js",
  "bin": {
    "shoulders-mcp-server": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shoulders",
    "kubernetes",
    "developer-platform"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
